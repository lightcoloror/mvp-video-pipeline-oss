{
  "schema_version": "agent-tool-manifest.v1",
  "id": "mvp-video-pipeline",
  "manifest_version": "1.9.0",
  "description": "Candidate-only video planning, deterministic synthetic rendering, evidence-driven smart reframing, technical QA, and review handoff over content-video-brief.v1.",
  "capabilities": [
    "video_brief_validation",
    "candidate_video_plan",
    "synthetic_mp4",
    "technical_qa",
    "release_gate_v2_export_qa_binding",
    "gateway_consumer",
    "privacy_quality_gate",
    "privacy_redaction_candidate_sidecar",
    "privacy_dynamic_layout_avoidance",
    "vertical_composition_layout_gate",
    "candidate_safe_media_layout",
    "candidate_external_skill_handoff",
    "content_visual_routing",
    "cross_renderer_style_profile",
    "hyperframes_music_analysis_handoff",
    "spoken_bgm_minimum_correct_mix",
    "hyperframes_render_assurance",
    "title_cover_candidate_packaging",
    "remotion_still_cover_candidates",
    "spoken_rough_cut_candidate_decisions",
    "deliverable_routed_spoken_review_video_and_editor_handoff",
    "jianying_editable_project_handoff",
    "smart_reframe_candidate_plan",
    "smart_reframe_debug_overlay",
    "owner_no_write_doctor",
    "portable_recovery_fixture"
  ],
  "interfaces": {
    "canonical": [
      {
        "kind": "cli",
        "command": "python scripts/spoken_rough_cut.py select-delivery --plan <spoken-edit-plan.json> --request <delivery-request.json> --output <new-selection.json>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "python scripts/spoken_rough_cut.py prepare-delivery --selection <selection.json> --output-dir <new-delivery-dir>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "python scripts/spoken_rough_cut.py render-delivery --selection <selection.json> --output-dir <new-render-dir> --project-root <project-root> --lifecycle-manifest <manifest.json> --estimated-output-bytes <positive-bytes>",
        "mode": "explicit_local_candidate_export_only"
      },
      {
        "kind": "cli",
        "command": "python scripts/owner_manifest_doctor.py --tool-id mvp-video-pipeline --format json",
        "mode": "read_only_metadata"
      },
      {
        "kind": "cli",
        "command": "python scripts/content_video.py doctor",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "python scripts/content_video.py validate --brief <brief.json> --schema <brief-schema.json> --research-output <research.json> --research-schema <research-schema.json>",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "python scripts/content_video.py generate-synthetic --brief <brief.json> --schema <brief-schema.json> --research-output <research.json> --research-schema <research-schema.json> --output-root <output>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "python scripts/content_video.py read-artifact <artifact.json>",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "python scripts/ffmpeg_outlet.py --operation <operation> --input <role=path> --output <role=path> --receipt <receipt.json> [--capture-log <log>] -- ffmpeg <args>",
        "mode": "local_candidate_write_fail_closed"
      },
      {
        "kind": "cli",
        "command": "video-visual-routing build-routes --packaging-plan <packaging.json> --routing-spec <routing-spec.json> --style-profile <visual-style.json> --output <visual-routes.json>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-visual-routing music-doctor --source-root <fixed-hyperframes-source>",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "video-music-pipeline build-edit-plan --candidates <music-candidate-set.json> [--word-timestamps <words.json> | --subtitles <dialogue.srt>] --contract-version v2 --output <music-edit-plan.json>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-hyperframes-renderkit doctor --renderkit-source <fixed-renderkit-source>",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "video-title-cover build --project-plan <project-plan.json> --spec <title-cover-spec.json> --output <title-cover-plan.json>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-spoken-rough-cut doctor --videocut-source <fixed-videocut-kit-source>",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "video-jianying-draft doctor --vectcut-source <fixed-vectcut-source>",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "video-privacy-gate doctor",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "video-privacy-gate redact-plan --spec <redaction-spec.json> --output <redaction-job.json>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-privacy-gate redact-preview --job <redaction-job.json> --output <preview-or-handoff>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-privacy-gate redact-run --job <redaction-job.json> --receipt <redaction-receipt.json> --capture-zones",
        "mode": "approval_required_local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-privacy-gate redact-zones --receipt <redaction-receipt.json> --output <privacy-zones.json> [--reframe-plan <smart-reframe-plan.json> | --identity-final-canvas]",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-privacy-gate redact-layout-check --semantic-motion <semantic-motion-plan.json> --zones <privacy-zones.json> --output <collision-report.json>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-privacy-gate redact-layout-debug --semantic-motion <semantic-motion-plan.json> --project-dir <empty-debug-project>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-smart-reframe doctor",
        "mode": "read_only_offline"
      },
      {
        "kind": "cli",
        "command": "video-smart-reframe build --source <source-media> --request <request.json> --evidence <evidence.json> --output <plan.json>",
        "mode": "local_candidate_write"
      },
      {
        "kind": "cli",
        "command": "video-smart-reframe render-debug-overlay --plan <plan.json> --output <crop-overlay.mp4> --work-dir <empty-run-dir>",
        "mode": "local_candidate_write"
      }
    ],
    "windows_wrappers": [],
    "http": [],
    "mcp": []
  },
  "inputs": [
    {
      "name": "content_video_brief",
      "contract": "content-video-brief.v1/content-brief.v1",
      "required": true
    },
    {
      "name": "research_output",
      "contract": "research-output.v1/evidence-bundle.v1",
      "required": true
    },
    {
