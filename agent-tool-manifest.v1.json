      "contract": "video_creation_pipeline.visual_style_profile.v1",
      "required": false
    },
    {
      "name": "title_cover_candidate_spec",
      "contract": "video_creation_pipeline.title_cover_candidate_spec.v1",
      "required": false
    },
    {
      "name": "spoken_word_tokens",
      "contract": "timestamped word tokens plus source media SHA-256",
      "required": false
    },
    {
      "name": "speech_timing_evidence",
      "contract": "word timestamp receipt or SRT subtitle; explicit semantic-segment fallback when neither is available",
      "required": false
    },
    {
      "name": "smart_reframe_evidence",
      "contract": "video_creation_pipeline.smart_reframe_evidence.v1 plus source media SHA-256",
      "required": false
    },
    {
      "name": "privacy_redaction_job",
      "contract": "video_creation_pipeline.privacy_redaction_job.v1 plus explicit third-party runtime/model SHA-256",
      "required": false
    },
    {
      "name": "privacy_exclusion_zones",
      "contract": "video_creation_pipeline.privacy_exclusion_zones.v1 plus source/redaction and explicit reframe-or-identity SHA-256 projection bindings",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "candidate_video_bundle",
      "contract": "candidate-only MP4/subtitles/cover/technical QA/manifest",
      "required": true
    },
    {
      "name": "review_packet",
      "contract": "review-packet.v1",
      "required": true
    },
    {
      "name": "content_visual_routing_plan",
      "contract": "video_creation_pipeline.content_visual_routing_plan.v1",
      "required": false
    },
    {
      "name": "title_cover_candidate_plan",
      "contract": "video_creation_pipeline.title_cover_candidate_plan.v1",
      "required": false
    },
    {
      "name": "spoken_edit_plan",
      "contract": "video_creation_pipeline.spoken_edit_plan.v2; v1 read compatibility, delivery selected separately",
      "required": false
    },
    {
      "name": "music_edit_plan_v2",
      "contract": "video_creation_pipeline.music_edit_plan.v2 with fixed spoken-BGM policy, evidence provenance, and unchanged semantic timeline",
      "required": false
    },
    {
      "name": "spoken_bgm_candidate",
      "contract": "candidate-only mixed audio/video plus FFmpeg receipt, decode QA, duration/peak checks, and source/music SHA-256",
      "required": false
    },
    {
      "name": "hyperframes_render_assurance",
      "contract": "video_creation_pipeline.hyperframes_render_assurance_plan.v1 plus preflight receipt",
      "required": false
    },
    {
      "name": "jianying_project_handoff",
      "contract": "candidate draft receipt, project-folder receipt, and separate desktop-validation receipt",
      "required": false
    },
    {
      "name": "smart_reframe_candidate",
      "contract": "video_creation_pipeline.smart_reframe_plan.v1, optional candidate MP4/debug overlay, QA, and FFmpeg receipts",
      "required": false
    },
    {
      "name": "privacy_redaction_candidate",
      "contract": "video_creation_pipeline.privacy_redaction_receipt.v1, candidate_only, privacy rescan required",
      "required": false
    },
    {
      "name": "privacy_layout_collision_report",
      "contract": "video_creation_pipeline.privacy_layout_collision_report.v1, candidate_only, final privacy rescan required",
      "required": false
    }
  ],
  "health": {
    "doctor": {
