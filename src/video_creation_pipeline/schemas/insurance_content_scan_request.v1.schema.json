{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.insurance_content_scan_request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "policy_pack", "distribution_channel", "content", "evidence", "authority_boundary", "request_sha256"],
  "properties": {
    "schema": {"const": "video_creation_pipeline.insurance_content_scan_request.v1"},
    "created_at": {"type": "string", "minLength": 1},
    "policy_pack": {"$ref": "#/$defs/artifact"},
    "distribution_channel": {"type": "string", "minLength": 1},
    "content": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["content_id", "role", "artifact"],
        "properties": {
          "content_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "evidence": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "evidence_type", "supports_rule_ids", "valid_from", "valid_until", "artifact"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_type": {"type": "string", "minLength": 1},
          "supports_rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "valid_from": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "valid_until": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "artifact": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "authority_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["local_artifacts_only", "external_provider_called", "automatic_upload", "automatic_publish"],
      "properties": {
        "local_artifacts_only": {"const": true},
        "external_provider_called": {"const": false},
        "automatic_upload": {"const": false},
        "automatic_publish": {"const": false}
      }
    },
    "request_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  }
}
