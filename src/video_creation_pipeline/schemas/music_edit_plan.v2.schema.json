{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightcoloror.local/schemas/music_edit_plan.v2.schema.json",
  "title": "Music Edit Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_set",
    "mix_policy",
    "speech_timing_evidence",
    "selection_policy",
    "selections",
    "readiness",
    "transition_policy",
    "ffmpeg_handoff",
    "authority_boundary",
    "music_edit_plan_sha256"
  ],
  "properties": {
    "schema": {
      "const": "video_creation_pipeline.music_edit_plan.v2"
    },
    "candidate_set": {
      "type": "object"
    },
    "mix_policy": {
      "type": "object"
    },
    "speech_timing_evidence": {
      "type": "object"
    },
    "selection_policy": {
      "type": "object"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "status",
          "music_family",
          "semantic_timeline_moved"
        ]
      }
    },
    "readiness": {
      "type": "object"
    },
    "transition_policy": {
      "type": "object"
    },
    "ffmpeg_handoff": {
      "type": "object"
    },
    "authority_boundary": {
      "type": "object"
    },
    "music_edit_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
