{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.privacy_review_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "reviewed_at", "reviewer", "source_report",
    "reviewed_final_artifact", "human_full_media_review_completed",
    "decisions", "outcome", "authority_boundary", "decision_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.privacy_review_decision.v1"},
    "reviewed_at": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "source_report": {"$ref": "#/$defs/artifact"},
    "reviewed_final_artifact": {"$ref": "#/$defs/artifact"},
    "human_full_media_review_completed": {"type": "boolean"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "disposition", "reason", "authorization_scope"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^privacy-[0-9a-f]{20}$"},
          "disposition": {"enum": ["redact", "authorized_keep", "false_positive"]},
          "reason": {"type": "string", "minLength": 1},
          "authorization_scope": {"type": "string"}
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_finding_decisions", "incomplete_required_lanes",
        "redact_required_count", "privacy_gate_passed", "release_blocked", "status"
      ],
      "properties": {
        "missing_finding_decisions": {"type": "array", "items": {"type": "string"}},
        "incomplete_required_lanes": {"type": "array", "items": {"type": "string"}},
        "redact_required_count": {"type": "integer", "minimum": 0},
        "privacy_gate_passed": {"type": "boolean"},
        "release_blocked": {"type": "boolean"},
        "status": {"enum": ["privacy_review_passed", "blocked"]}
      }
    },
    "authority_boundary": {"type": "object"},
    "decision_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  }
}
