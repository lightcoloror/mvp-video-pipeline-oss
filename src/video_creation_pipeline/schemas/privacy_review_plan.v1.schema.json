{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.privacy_review_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "created_at", "final_artifact", "privacy_terms",
    "authorization_evidence", "evidence", "subject_policy", "scan_policy",
    "provider_contracts", "authority_boundary", "plan_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.privacy_review_plan.v1"},
    "created_at": {"type": "string", "minLength": 1},
    "final_artifact": {"$ref": "#/$defs/artifact"},
    "privacy_terms": {"$ref": "#/$defs/artifact"},
    "authorization_evidence": {
      "oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]
    },
    "evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact"],
        "properties": {
          "role": {
            "enum": ["transcript", "subtitle", "script", "ocr_text", "document_text", "frame_report"]
          },
          "artifact": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "subject_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "face", "voice"],
      "properties": {
        "mode": {"enum": ["authorized_identifiable", "deidentified", "synthetic"]},
        "face": {"enum": ["allowed", "must_mask", "not_applicable"]},
        "voice": {"enum": ["allowed", "must_mask", "not_applicable"]}
      }
    },
    "scan_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_lanes", "visual_sample_interval_s", "max_visual_frames",
        "ocr_language", "scan_actual_final_artifact",
        "store_raw_sensitive_matches", "human_full_media_review_required"
      ],
      "properties": {
        "required_lanes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["text", "audio", "visual", "metadata"]}
        },
        "visual_sample_interval_s": {"type": "number", "exclusiveMinimum": 0},
        "max_visual_frames": {"type": "integer", "minimum": 1, "maximum": 5000},
        "ocr_language": {"type": "string", "minLength": 1},
        "scan_actual_final_artifact": {"const": true},
        "store_raw_sensitive_matches": {"const": false},
        "human_full_media_review_required": {"const": true}
      }
    },
    "provider_contracts": {"type": "object"},
    "authority_boundary": {"type": "object"},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    }
  }
}
