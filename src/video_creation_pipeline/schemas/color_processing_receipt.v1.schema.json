{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.color_processing_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source_plan",
    "source_plan_sha256",
    "render_ffmpeg_receipt",
    "post_analysis_report",
    "staged_video",
    "processed_video",
    "audio_packet_qa",
    "technical_qa",
    "review",
    "authority_boundary",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.color_processing_receipt.v1"},
    "status": {"const": "completed_technical_candidate_needs_visual_review"},
    "source_plan": {"$ref": "#/$defs/artifact"},
    "source_plan_sha256": {"$ref": "#/$defs/sha256"},
    "render_ffmpeg_receipt": {"$ref": "#/$defs/artifact"},
    "post_analysis_report": {"$ref": "#/$defs/artifact"},
    "staged_video": {"$ref": "#/$defs/artifact"},
    "processed_video": {"$ref": "#/$defs/artifact"},
    "audio_packet_qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "processed"],
      "properties": {
        "source": {"oneOf": [{"$ref": "#/$defs/audio_qa"}, {"type": "null"}]},
        "processed": {"oneOf": [{"$ref": "#/$defs/audio_qa"}, {"type": "null"}]}
      }
    },
    "technical_qa": {"type": "object"},
    "review": {"type": "object"},
    "authority_boundary": {"type": "object"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "audio_qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_sha256", "log", "ffmpeg_receipt"],
      "properties": {
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "log": {"$ref": "#/$defs/artifact"},
        "ffmpeg_receipt": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
