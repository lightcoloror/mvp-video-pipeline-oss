{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.insurance_content_policy_pack.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "policy_id", "version", "jurisdiction", "reviewed_at",
    "review_due_at", "official_sources", "categories", "evidence_types",
    "role_requirements", "rules", "authority_boundary", "policy_pack_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.insurance_content_policy_pack.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "jurisdiction": {"const": "CN"},
    "reviewed_at": {"type": "string", "minLength": 1},
    "review_due_at": {"type": "string", "minLength": 1},
    "official_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "title", "authority", "url", "published_at", "effective_from", "lifecycle"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "minLength": 1},
          "effective_from": {"type": "string", "minLength": 1},
          "lifecycle": {"enum": ["effective", "future"]}
        }
      }
    },
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "role_requirements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "severity", "required_evidence_types", "source_ids"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "severity": {"enum": ["block", "compliance_review", "fact_check"]},
          "required_evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "rule_id", "category", "severity", "detection", "patterns",
          "applies_to_roles", "required_evidence_types", "source_ids", "guidance"
        ],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["block", "compliance_review", "fact_check"]},
          "detection": {"enum": ["literal_any", "regex_any"]},
          "patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "applies_to_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "required_evidence_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "guidance": {"type": "string", "minLength": 1}
        }
      }
    },
    "authority_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_policy_only", "legal_opinion", "automatic_rewrite", "automatic_publish"],
      "properties": {
        "candidate_policy_only": {"const": true},
        "legal_opinion": {"const": false},
        "automatic_rewrite": {"const": false},
        "automatic_publish": {"const": false}
      }
    },
    "policy_pack_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
