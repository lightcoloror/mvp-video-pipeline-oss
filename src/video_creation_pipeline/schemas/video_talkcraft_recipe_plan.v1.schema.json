{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.video_talkcraft_recipe_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_semantic_motion_plan",
    "source_word_timestamps",
    "source_selections",
    "external_catalog",
    "output",
    "selection_policy",
    "cues",
    "authority_boundary",
    "plan_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.video_talkcraft_recipe_plan.v1"},
    "source_semantic_motion_plan": {"$ref": "#/$defs/artifact"},
    "source_word_timestamps": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "source_selections": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "external_catalog": {"$ref": "#/$defs/catalog"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 320, "maximum": 7680},
        "height": {"type": "integer", "minimum": 320, "maximum": 7680},
        "fps": {"type": "integer", "enum": [24, 25, 30, 50, 60]}
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "automatic_full_catalog_selection",
        "unknown_recipe_fallback",
        "source_code_vendored",
        "source_audio_reused",
        "commercial_authorization"
      ],
      "properties": {
        "mode": {"const": "insurance_safe_whitelist"},
        "automatic_full_catalog_selection": {"const": false},
        "unknown_recipe_fallback": {"const": false},
        "source_code_vendored": {"const": false},
        "source_audio_reused": {"const": false},
        "commercial_authorization": {"const": "not_evidenced"}
      }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/cue"}
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidate_only",
        "semantic_timeline_moved",
        "second_asr_created",
        "second_ffmpeg_outlet_created",
        "automatic_publish"
      ],
      "properties": {
        "status": {"const": "ready_for_local_noncommercial_pilot"},
        "candidate_only": {"const": true},
        "semantic_timeline_moved": {"const": false},
        "second_asr_created": {"const": false},
        "second_ffmpeg_outlet_created": {"const": false},
        "automatic_publish": {"const": false}
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "sourceMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "durationInFrames"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1},
        "durationInFrames": {"type": "integer", "minimum": 1}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "repository",
        "commit",
        "license_sha256",
        "taxonomy_sha256",
        "sfx_map_sha256",
        "cards",
        "catalog_sha256"
      ],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "repository": {"const": "https://github.com/Vincentwei1021/video-talkcraft"},
        "commit": {"const": "05691f5f25d91d211f793f5bb0d6941d3ef5723d"},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "taxonomy_sha256": {"$ref": "#/$defs/sha256"},
        "sfx_map_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_sha256": {"$ref": "#/$defs/sha256"},
        "cards": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recipe_id",
              "relative_path",
              "sha256",
              "category",
              "allowed_information_roles",
              "entry_offset_s",
              "source_meta",
              "source_sfx_cues"
            ],
            "properties": {
              "recipe_id": {"type": "string", "minLength": 1},
              "relative_path": {"type": "string", "pattern": "^template/cards/.+\\.tsx$"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "category": {"type": "string", "minLength": 1},
              "allowed_information_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["structure", "relationship", "sequence", "comparison", "number", "evidence"]}
              },
              "entry_offset_s": {"type": "number", "minimum": 0, "maximum": 2},
              "source_meta": {"$ref": "#/$defs/sourceMeta"},
              "source_sfx_cues": {
                "type": "array",
                "items": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "story_segment_ref",
        "semantic_motion_cue_ref",
        "information_role",
        "recipe_id",
        "recipe_source",
        "anchor",
        "entry_contract",
        "duration_contract",
        "target_rect",
        "protected_regions",
        "mobile_gate",
        "sfx_candidates"
      ],
      "properties": {
        "cue_id": {"type": "string", "minLength": 1},
        "story_segment_ref": {"type": "string", "minLength": 1},
        "semantic_motion_cue_ref": {"type": "string", "minLength": 1},
        "information_role": {"enum": ["structure", "relationship", "sequence", "comparison", "number", "evidence"]},
        "recipe_id": {"type": "string", "minLength": 1},
        "recipe_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relative_path", "sha256", "source_meta"],
          "properties": {
            "relative_path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "source_meta": {"$ref": "#/$defs/sourceMeta"}
          }
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "start_s", "end_s", "source", "exact_text_match"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "start_s": {"type": "number", "minimum": 0},
            "end_s": {"type": "number", "minimum": 0},
            "source": {"enum": ["word_timestamps", "semantic_script_anchor"]},
            "exact_text_match": {"type": "boolean"}
          }
        },
        "entry_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence_start_s",
            "sequence_start_frame",
            "declared_first_meaningful_frame",
            "anchor_frame",
            "deadline_frame",
            "tolerance_frames",
            "observation_required"
          ],
          "properties": {
            "sequence_start_s": {"type": "number", "minimum": 0},
            "sequence_start_frame": {"type": "integer", "minimum": 0},
            "declared_first_meaningful_frame": {"type": "integer", "minimum": 0},
            "anchor_frame": {"type": "integer", "minimum": 0},
            "deadline_frame": {"type": "integer", "minimum": 0},
            "tolerance_frames": {"type": "integer", "minimum": 1},
            "observation_required": {"const": true}
          }
        },
        "duration_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_duration_s", "allocated_duration_s", "tail_truncated"],
          "properties": {
            "source_duration_s": {"type": "number", "exclusiveMinimum": 0},
            "allocated_duration_s": {"type": "number", "exclusiveMinimum": 0},
            "tail_truncated": {"type": "boolean"}
          }
        },
        "target_rect": {"$ref": "#/$defs/rect"},
        "protected_regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rect"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "rect": {"$ref": "#/$defs/rect"}
            }
          }
        },
        "mobile_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preview_widths", "minimum_design_font_px", "overflow_must_be_false", "critical_text_must_be_visible"],
          "properties": {
            "preview_widths": {"const": [270, 390]},
            "minimum_design_font_px": {"type": "integer", "minimum": 1},
            "overflow_must_be_false": {"const": true},
            "critical_text_must_be_visible": {"const": true}
          }
        },
        "sfx_candidates": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "timeline_start_s", "offset_s", "function", "source_sound_name", "source_volume", "action", "source_audio_reused"],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "timeline_start_s": {"type": "number", "minimum": 0},
              "offset_s": {"type": "number", "minimum": 0},
              "function": {"enum": ["orientation", "transition", "emphasis", "caution", "commitment", "causality", "resolution"]},
              "source_sound_name": {"type": "string", "minLength": 1},
              "source_volume": {"type": "number", "minimum": 0},
              "action": {"type": "string", "minLength": 1},
              "source_audio_reused": {"const": false}
            }
          }
        }
      }
    }
  }
}
