{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.jianying_desktop_validation_receipt.v1",
  "title": "剪映桌面可编辑验证回执 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_project_receipt",
    "validated_at",
    "validated_by",
    "jianying_version",
    "observed_segment_count",
    "checks",
    "post_save_project_files",
    "post_save_manifest_sha256",
    "evidence",
    "status",
    "candidate_only",
    "release_approval_claimed",
    "source_media_modified",
    "effects_added",
    "automatic_publish",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.jianying_desktop_validation_receipt.v1"},
    "source_project_receipt": {"type": "object"},
    "validated_at": {"type": "string", "format": "date-time"},
    "validated_by": {"type": "string", "minLength": 1},
    "jianying_version": {"type": "string", "minLength": 1},
    "observed_segment_count": {"type": "integer", "minimum": 1},
    "checks": {"type": "object"},
    "post_save_project_files": {"type": "array", "minItems": 1},
    "post_save_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {"type": "array"},
    "status": {"const": "desktop_validated_editable_candidate"},
    "candidate_only": {"const": true},
    "release_approval_claimed": {"const": false},
    "source_media_modified": {"const": false},
    "effects_added": {"const": false},
    "automatic_publish": {"const": false},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
