  "properties": {
    "schema": {
      "const": "video_creation_pipeline.external_motion_selection_plan.v1"
    },
    "source_catalog": {"type": "object"},
    "source_semantic_motion_plan": {"type": "object"},
    "overrides": {"type": ["object", "null"]},
    "selections": {"type": "array", "minItems": 1},
    "selection_policy": {"type": "object"},
    "authority_boundary": {"type": "object"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
