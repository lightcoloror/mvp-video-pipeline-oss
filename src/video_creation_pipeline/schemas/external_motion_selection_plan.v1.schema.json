{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.external_motion_selection_plan.v1",
  "type": "object",
  "required": [
    "schema",
    "source_catalog",
    "source_semantic_motion_plan",
    "overrides",
    "selections",
    "selection_policy",
    "authority_boundary",
    "plan_sha256"
