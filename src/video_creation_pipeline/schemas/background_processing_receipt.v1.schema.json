{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.background_processing_receipt.v1",
  "title": "Background Processing Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source_plan",
    "source_plan_sha256",
    "frame_extract_receipt",
    "provider_receipt",
    "matting_manifest",
    "alpha_qa_receipt",
    "alpha_qa_log",
    "composite_ffmpeg_receipt",
    "staged_video",
    "processed_video",
    "mode",
    "technical_qa",
    "review",
    "authority_boundary",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.background_processing_receipt.v1"},
    "status": {"const": "completed_technical_candidate_needs_visual_review"},
    "source_plan": {"$ref": "#/$defs/artifact"},
    "source_plan_sha256": {"$ref": "#/$defs/sha256"},
    "frame_extract_receipt": {"$ref": "#/$defs/artifact"},
    "provider_receipt": {"$ref": "#/$defs/artifact"},
    "matting_manifest": {"$ref": "#/$defs/artifact"},
    "alpha_qa_receipt": {"$ref": "#/$defs/artifact"},
    "alpha_qa_log": {"$ref": "#/$defs/artifact"},
    "composite_ffmpeg_receipt": {"$ref": "#/$defs/artifact"},
    "staged_video": {"$ref": "#/$defs/artifact"},
    "processed_video": {"$ref": "#/$defs/artifact"},
    "mode": {"enum": ["blur", "replace_color", "replace_image", "transparent"]},
    "technical_qa": {"type": "object"},
    "review": {"type": "object"},
    "authority_boundary": {"type": "object"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {"type": ["string", "null"]}
      }
    }
  }
}
