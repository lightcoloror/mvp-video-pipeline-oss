{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.spoken_edit_judge_packet.v1",
  "title": "口播净剪判定材料包 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_video",
    "tokens",
    "silence",
    "reference_script",
    "reference_script_authority",
    "videocut_kit",
    "judge_candidates",
    "judge_fulltext",
    "candidate_count",
    "candidate_kind_counts",
    "pacing_policy",
    "agent_review_contract",
    "execution_boundary",
    "prepare_log",
    "packet_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.spoken_edit_judge_packet.v1"},
    "source_video": {"$ref": "#/$defs/artifact"},
    "tokens": {"$ref": "#/$defs/artifact"},
    "silence": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "reference_script": {"oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
    "reference_script_authority": {"const": "non_authoritative_reference"},
    "videocut_kit": {"type": "object"},
    "judge_candidates": {"$ref": "#/$defs/artifact"},
    "judge_fulltext": {"$ref": "#/$defs/artifact"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "candidate_kind_counts": {"type": "object"},
    "pacing_policy": {"type": "object"},
    "agent_review_contract": {"type": "object"},
    "execution_boundary": {"type": "object"},
    "prepare_log": {"type": "object"},
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {"type": ["string", "null"]}
      }
    }
  }
}
