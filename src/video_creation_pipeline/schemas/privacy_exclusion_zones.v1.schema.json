{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.privacy_exclusion_zones.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_media",
    "redacted_media",
    "source_redaction_job",
    "source_redaction_receipt",
    "coordinate_space",
    "media_clock",
    "detector",
    "redaction_parameters",
    "scene_cuts",
    "tracks",
    "coverage",
    "authority_boundary",
    "zones_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.privacy_exclusion_zones.v1"},
    "source_media": {"$ref": "#/$defs/artifact"},
    "redacted_media": {"$ref": "#/$defs/artifact"},
    "source_redaction_job": {"$ref": "#/$defs/artifact"},
    "source_redaction_receipt": {"$ref": "#/$defs/artifact"},
    "source_privacy_exclusion_zones": {"$ref": "#/$defs/artifact"},
    "source_smart_reframe_plan": {"$ref": "#/$defs/artifact"},
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source_width", "source_height", "target_width", "target_height"],
      "properties": {
        "method": {"enum": ["identity", "smart_reframe_plan"]},
        "source_width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "source_height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "target_width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "target_height": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    },
    "coordinate_space": {
      "enum": ["redaction_input_normalized", "final_canvas_normalized"]
    },
    "media_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "frame_count", "width", "height", "duration_s"],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
        "frame_count": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "source_commit",
        "model_hash",
        "target_types",
        "same_invocation_as_redaction"
      ],
      "properties": {
        "tool": {"const": "SentryBlur"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "model_hash": {"$ref": "#/$defs/sha256"},
        "target_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["face", "plate", "manual_region"]}
        },
        "same_invocation_as_redaction": {"const": true}
      }
    },
    "redaction_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dilation_px", "temporal_window_frames"],
      "properties": {
        "dilation_px": {"type": "integer", "minimum": 0, "maximum": 512},
        "temporal_window_frames": {"type": "integer", "minimum": 0, "maximum": 301}
      }
    },
    "scene_cuts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "tracks": {
      "type": "array",
      "items": {"$ref": "#/$defs/track"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "covered_frame_count",
        "uncovered_spans",
        "review_required"
      ],
      "properties": {
        "status": {"enum": ["complete", "review_required"]},
        "covered_frame_count": {"type": "integer", "minimum": 0},
        "uncovered_spans": {
          "type": "array",
          "items": {"$ref": "#/$defs/span"}
        },
        "review_required": {"type": "boolean"}
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "identity_recognition_performed",
        "layout_authority",
        "publish_allowed",
        "final_privacy_rescan_required"
      ],
      "properties": {
        "candidate_only": {"const": true},
        "identity_recognition_performed": {"const": false},
        "layout_authority": {"const": "semantic_motion_plan"},
        "publish_allowed": {"const": false},
        "final_privacy_rescan_required": {"const": true}
      }
    },
    "zones_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_index",
        "pts_s",
        "confidence",
        "source",
        "raw_rect",
        "effective_rect",
        "visible"
      ],
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0},
        "pts_s": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"enum": ["same_invocation_detection", "temporal_union", "manual_region"]},
        "raw_rect": {"$ref": "#/$defs/rect"},
        "effective_rect": {"$ref": "#/$defs/rect"},
        "source_raw_rect": {"$ref": "#/$defs/rect"},
        "source_effective_rect": {"$ref": "#/$defs/rect"},
        "visible": {"type": "boolean"}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "target_type", "identity_claimed", "zones"],
      "properties": {
        "track_id": {"type": "string", "pattern": "^anonymous-[a-z0-9-]+$"},
        "target_type": {"enum": ["face", "plate", "manual_region"]},
        "identity_claimed": {"const": false},
        "zones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame", "reason"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
