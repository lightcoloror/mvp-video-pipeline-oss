{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.privacy_redaction_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "status",
    "job",
    "job_sha256",
    "input",
    "output",
    "stages",
    "multi_encode",
    "engine",
    "ffprobe",
    "full_decode",
    "duration",
    "audio",
    "execution_policy",
    "publish_allowed",
    "rescan_required",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.privacy_redaction_receipt.v1"},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"const": "candidate_only"},
    "job": {"$ref": "#/$defs/artifact"},
    "job_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {"$ref": "#/$defs/artifact"},
    "output": {"$ref": "#/$defs/artifact"},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "multi_encode": {"type": "boolean"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tool_version",
        "source_commit",
        "executable_sha256",
        "model_hash"
      ],
      "properties": {
        "name": {"enum": ["SentryBlur", "CloakFrame"]},
        "tool_version": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "executable_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_root_sha256_before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_root_sha256_after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_cache_unchanged": {"type": "boolean"},
        "provider_audit": {"$ref": "#/$defs/providerAudit"},
        "coordinate_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "same_invocation_as_redaction",
            "format",
            "stage_count"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "same_invocation_as_redaction": {"type": "boolean"},
            "format": {
              "oneOf": [
                {"const": "jsonl_xyxy_v1"},
                {"type": "null"}
              ]
            },
            "stage_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "ffprobe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {"input": {"type": "object"}, "output": {"type": "object"}}
    },
    "full_decode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "command", "returncode", "stderr_tail"],
      "properties": {
        "verified": {"type": "boolean"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "returncode": {"type": "integer"},
        "stderr_tail": {"type": "string"}
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_s", "output_s", "error_s", "max_error_s", "within_one_frame"],
      "properties": {
        "input_s": {"type": "number", "exclusiveMinimum": 0},
        "output_s": {"type": "number", "exclusiveMinimum": 0},
        "error_s": {"type": "number", "minimum": 0},
        "max_error_s": {"type": "number", "exclusiveMinimum": 0},
        "within_one_frame": {"type": "boolean"}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_present",
        "output_present",
        "input_duration_s",
        "output_duration_s",
        "duration_error_s",
        "within_one_frame",
        "preserved"
      ],
      "properties": {
        "input_present": {"type": "boolean"},
        "output_present": {"type": "boolean"},
        "input_duration_s": {"type": ["number", "null"]},
        "output_duration_s": {"type": ["number", "null"]},
        "duration_error_s": {"type": ["number", "null"]},
        "within_one_frame": {"type": "boolean"},
        "preserved": {"type": "boolean"}
      }
    },
    "execution_policy": {"$ref": "#/$defs/executionPolicy"},
    "publish_allowed": {"const": false},
    "rescan_required": {"const": true},
    "cloakframe_adoption": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "content_kind", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_kind": {"enum": ["binary", "json"]},
        "canonical_sha256": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "providerAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_version",
        "requested_execution_provider",
        "primary_execution_provider",
        "available_execution_providers",
        "actual_execution_providers",
        "cuda_libraries_preloaded",
        "provider_requirement_met"
      ],
      "properties": {
        "runtime_version": {"type": "string", "minLength": 1},
        "requested_execution_provider": {
          "enum": ["CUDAExecutionProvider", "CPUExecutionProvider"]
        },
        "primary_execution_provider": {
          "enum": ["CUDAExecutionProvider", "CPUExecutionProvider"]
        },
        "available_execution_providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "actual_execution_providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cuda_libraries_preloaded": {"type": "boolean"},
        "provider_requirement_met": {"const": true}
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "requires_explicit_execution",
        "automatic_fallback",
        "rescan_required",
        "automatic_publish",
        "source_media_modified",
        "network_model_download_allowed"
      ],
      "properties": {
        "candidate_only": {"const": true},
        "requires_explicit_execution": {"const": true},
        "automatic_fallback": {"const": false},
        "rescan_required": {"const": true},
        "automatic_publish": {"const": false},
        "source_media_modified": {"const": false},
        "network_model_download_allowed": {"const": false}
      }
    }
  }
}
