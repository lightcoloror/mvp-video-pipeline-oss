{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_creation_pipeline.jianying_project_folder_receipt.v1",
  "title": "剪映完整项目目录生成回执 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_draft_receipt",
    "source_job_schema",
    "project_dir",
    "project_files",
    "project_manifest_sha256",
    "profile",
    "vectcut_project_source",
    "segment_count",
    "status",
    "candidate_only",
    "full_project_folder_generated",
    "jianying_runtime_validated",
    "next_action",
    "execution_boundary",
    "worker",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "video_creation_pipeline.jianying_project_folder_receipt.v1"},
    "source_draft_receipt": {"type": "object"},
    "source_job_schema": {"type": "string", "minLength": 1},
    "project_dir": {"type": "string", "minLength": 1},
    "project_files": {"type": "array", "minItems": 1},
    "project_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"const": "jianying_pro_10"},
    "vectcut_project_source": {"type": "object"},
    "segment_count": {"type": "integer", "minimum": 1},
    "status": {"const": "candidate_project_folder_generated"},
    "candidate_only": {"const": true},
    "full_project_folder_generated": {"const": true},
    "jianying_runtime_validated": {"const": false},
    "next_action": {"const": "open_in_jianying_and_record_desktop_validation"},
    "execution_boundary": {"type": "object"},
    "worker": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
