{
  "name": "natural_conversational_v2",
  "retry_rule": "delete_earlier_keep_last_fluent",
  "reference_script_role": "terminology_and_structure_reference_only",
  "source_speech_is_authoritative": true,
  "minimum_pause_candidate_s": 0.3,
  "within_sentence_compress_from_s": 0.5,
  "within_sentence_preserve_s": 0.3,
  "within_sentence_preserve_range_s": [0.25, 0.35],
  "between_sentences_compress_from_s": 0.9,
  "between_sentences_preserve_s": 0.55,
  "between_sentences_preserve_range_s": [0.45, 0.7],
  "leading_pause_compress_from_s": 0.4,
  "leading_pause_preserve_s": 0.2,
  "word_tail_guard_s": 0.15,
  "word_tail_guard_reference_range_s": [0.12, 0.18],
  "word_onset_guard_s": 0.1,
  "protected_pause_roles": ["emphasis", "emotion", "topic_change", "breath", "turn_taking"],
  "protected_pause_action": "keep_original_duration",
  "long_pause_default_action": "review_required",
  "pause_delete_allowed": false,
  "pause_compress_requires_audio_context_review": true,
  "numeric_basis": "editorial_starting_preset_not_universal_speech_standard",
  "minimum_delete_confidence": 0.7,
  "time_stretch_allowed": false,
  "remove_all_breaths": false,
  "machine_tight_pacing_allowed": false
}
