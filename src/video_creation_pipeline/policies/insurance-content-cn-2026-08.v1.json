  ],
  "evidence_types": [
    "product_terms", "product_current_status", "assumptions_and_limitations",
    "institution_review_authorization", "privacy_scan_report", "subject_authorization",
    "medical_source", "medical_boundary", "claim_process_source", "official_source"
  ],
  "role_requirements": [
    {
      "role": "customer_case",
      "severity": "block",
      "required_evidence_types": ["privacy_scan_report", "subject_authorization"],
      "source_ids": ["nfra-insurance-sales-2023-2"]
    },
    {
      "role": "product_explanation",
      "severity": "fact_check",
      "required_evidence_types": ["product_terms", "product_current_status", "assumptions_and_limitations"],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-internet-insurance-2020-13"]
    },
    {
      "role": "medical_explanation",
      "severity": "fact_check",
      "required_evidence_types": ["medical_source", "medical_boundary"],
      "source_ids": ["nfra-insurance-sales-2023-2"]
    },
    {
      "role": "sales_call_to_action",
      "severity": "compliance_review",
      "required_evidence_types": ["institution_review_authorization"],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-internet-insurance-2020-13"]
    }
  ],
  "rules": [
    {
      "rule_id": "claim_guarantee",
      "category": "claim_certainty",
      "severity": "block",
      "detection": "literal_any",
      "patterns": ["一定赔", "百分之百赔", "肯定能赔", "保证理赔", "买了就赔", "什么都赔", "全都能报"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "customer_case", "product_explanation", "sales_call_to_action"],
      "required_evidence_types": [],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-internet-insurance-2020-13"],
      "guidance": "不得把具体理赔结果表述为确定承诺，应回到合同责任、除外责任和实际审核条件。"
    },
    {
      "rule_id": "underwriting_guarantee",
      "category": "underwriting_certainty",
      "severity": "block",
      "detection": "literal_any",
      "patterns": ["一定能买", "保证承保", "肯定能过", "无条件承保", "谁都能买"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "customer_case", "product_explanation", "sales_call_to_action"],
      "required_evidence_types": [],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-suitability-2025-7"],
      "guidance": "承保取决于产品规则、健康告知和核保结论，不得预先保证。"
    },
    {
      "rule_id": "guaranteed_return",
      "category": "return_implication",
      "severity": "block",
      "detection": "literal_any",
      "patterns": ["稳赚不赔", "保本保收益", "保证收益", "零风险高收益", "收益百分百"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "product_explanation", "sales_call_to_action"],
      "required_evidence_types": [],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-internet-insurance-2020-13"],
      "guidance": "不得承诺不确定收益或隐藏假设、费用和风险条件。"
    },
    {
      "rule_id": "regulator_endorsement",
      "category": "regulatory_endorsement",
      "severity": "block",
      "detection": "literal_any",
      "patterns": ["监管推荐", "银保监会推荐", "金融监管总局推荐", "国家背书", "政府背书", "监管保证"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "product_explanation", "sales_call_to_action"],
      "required_evidence_types": [],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-internet-insurance-2020-13"],
      "guidance": "不得利用审核、备案或监管机构名义形成产品保证或推荐印象。"
    },
    {
      "rule_id": "improper_ranking",
      "category": "misleading_comparison",
      "severity": "compliance_review",
      "detection": "literal_any",
      "patterns": ["全网第一", "最划算", "性价比最高", "行业第一", "秒杀同类", "碾压同类"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "product_explanation", "sales_call_to_action"],
      "required_evidence_types": ["official_source", "assumptions_and_limitations"],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-internet-insurance-2020-13"],
      "guidance": "排名和比较必须有真实、准确、同口径资料并完整披露限制，简单排名仍需人工复核。"
    },
    {
      "rule_id": "scarcity_or_price_change",
      "category": "false_scarcity",
      "severity": "compliance_review",
      "detection": "literal_any",
      "patterns": ["马上停售", "即将停售", "最后机会", "马上涨价", "即将涨价", "最后一天"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "product_explanation", "sales_call_to_action"],
      "required_evidence_types": ["product_current_status", "official_source"],
      "source_ids": ["nfra-insurance-sales-2023-2"],
      "guidance": "停售或价格变化必须绑定保险公司正式公告及有效日期，不得制造虚假紧迫感。"
    },
    {
      "rule_id": "off_contract_inducement",
      "category": "inducement",
      "severity": "compliance_review",
      "detection": "literal_any",
      "patterns": ["返现", "返佣", "送礼", "回扣", "额外赠送"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "sales_call_to_action"],
      "required_evidence_types": ["institution_review_authorization"],
      "source_ids": ["nfra-insurance-sales-2023-2"],
      "guidance": "合同外利益、返佣或赠礼表达必须由机构合规确认。"
    },
    {
      "rule_id": "medical_certainty",
      "category": "medical_advice",
      "severity": "block",
      "detection": "literal_any",
      "patterns": ["一定治愈", "保证治愈", "包治", "无需就医", "替代医生", "肯定能治好"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "customer_case", "medical_explanation"],
      "required_evidence_types": [],
      "source_ids": ["nfra-insurance-sales-2023-2"],
      "guidance": "不得把个案或科普信息变成确定疗效承诺或替代临床判断。"
    },
    {
      "rule_id": "product_number_claim",
      "category": "product_facts_and_limits",
      "severity": "fact_check",
      "detection": "regex_any",
      "patterns": ["\\d+(?:\\.\\d+)?%", "\\d+(?:\\.\\d+)?(?:万|元|岁|年|天)"],
      "applies_to_roles": ["title", "hook", "script", "subtitle", "overlay_text", "cover_text", "product_explanation"],
      "required_evidence_types": ["product_terms", "product_current_status", "assumptions_and_limitations"],
      "source_ids": ["nfra-insurance-sales-2023-2", "nfra-internet-insurance-2020-13"],
      "guidance": "产品数字必须绑定条款或正式资料、日期、假设、适用条件和关键限制。"
    }
  ],
  "authority_boundary": {
    "candidate_policy_only": true,
    "legal_opinion": false,
