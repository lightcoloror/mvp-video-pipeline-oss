  "default_preset": "stroke_shadow_default",
  "governance": {
    "intent": "Provide a single shared source of truth for accessible default burned-in subtitles across FFmpeg/libass and Remotion.",
    "decision": "Adopt stroke_shadow_default (BorderStyle=1, 3.5px crisp dark outline + 2.5px soft shadow, TV.709) as default, box_stroke_bs4 (BorderStyle=4 single-layer box + 2px dark outline) as opt-in for bright receipts/busy text backdrops, and retain accessible_box_a / outline_v2_c for backward compatibility.",
    "contrast_target": "Immediate backing contrast >= 4.5:1 on worst-case white receipts and high-contrast striped backdrops, plus non-color speaker prefixes (WCAG 1.4.1)."
  },
